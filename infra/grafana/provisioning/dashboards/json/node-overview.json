        "legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "instance:node_memory_used_bytes{instance=\"$node\",job=\"$job\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "node_memory_MemAvailable_bytes{instance=\"$node\",job=\"$job\"}",
          "legendFormat": "available",
          "refId": "B"
        }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "spanNulls": false},
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 9,
      "maxDataPoints": 90,
      "options": {
        "legend": {"calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "instance:node_network_receive_bytes:rate{instance=\"$node\",job=\"$job\"}",
          "legendFormat": "rx {{device}}",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "instance:node_network_transmit_bytes:rate{instance=\"$node\",job=\"$job\"}",
          "legendFormat": "tx {{device}}",
          "refId": "B"
        }
      ],
      "title": "Network",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${ds_prometheus}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "spanNulls": false},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 10,
      "maxDataPoints": 90,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * instance:node_filesystem_root_used:ratio{instance=\"$node\",job=\"$job\"}",
          "legendFormat": "/",
          "refId": "A"
        }
      ],
      "title": "Disk / used",
      "type": "timeseries"
    }
