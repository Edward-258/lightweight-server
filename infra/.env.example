# 复制到两份 compose 同目录的 .env（业务栈 + docker-compose.woodpecker.yml 都读它）。不要提交 .env。

GRAFANA_ADMIN_PASSWORD=

# Alertmanager 的 QQ 邮箱 SMTP。填邮箱授权码，不要填登录密码。
SMTP_SMARTHOST=smtp.qq.com:465
SMTP_FROM=
SMTP_TO=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=

# Woodpecker（CI/CD 都走它）。openssl rand -hex 32 各生成一次 AGENT / GRPC。
# Gitea：设置 → 应用 → OAuth2 应用
#   名称：Woodpecker
#   重定向：https://example.com/woodpecker/authorize
WOODPECKER_AGENT_SECRET=
WOODPECKER_GRPC_SECRET=
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# Woodpecker 自己的 PROMETHEUS_AUTH_TOKEN 文件（WOODPECKER_PROMETHEUS_AUTH_TOKEN_FILE）。
# 只给 woodpecker-server 挂；Prometheus 刮 docker 网里的 :9001，不读这个文件。不要入库。
WOODPECKER_PROMETHEUS_TOKEN_FILE=/root/infra/secrets/woodpecker-prometheus-token

# Woodpecker clone 用的 Gitea SSH host key（known_hosts 一行）。不要提交 .env。
# 走 WOODPECKER_ENVIRONMENT + yaml 里 ${GITEA_SSH_HOST_KEY}，不要用逗号。
# 一把 ed25519 就够。改完后：docker compose up -d woodpecker-server
# 例：GITEA_SSH_HOST_KEY=gitea ssh-ed25519 AAAA...
GITEA_SSH_HOST_KEY=
